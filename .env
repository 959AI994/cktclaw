# CktClaw 环境变量 — 由 setup.sh 自动生成 (2026-06-23)

# EDA 工具路径
export PATH="/home/wjx/.cktclaw-tools/oss-cad-suite/bin:/home/wjx/pythonproject/cktclaw/deps/opensta-install/bin:${PATH}"

# Orchestrator 模板
export CHIP_AGENTS_ROOT="/home/wjx/pythonproject/cktclaw/deps/digital-chip-design-agents/plugins"

# AI4EDA 工具
export AI4EDA_BIN="/home/wjx/pythonproject/cktclaw/deps/AI4EDA-OpenABC-Data-Toolkit/ai4eda-toolkit"
export CKTCLAW_AI4EDA_PATH="/home/wjx/pythonproject/cktclaw/deps/AI4EDA-OpenABC-Data-Toolkit"

# Verilog Generator + FPGA Agent Skills
export VERILOG_GENERATOR_ROOT="/home/wjx/pythonproject/cktclaw/deps/verilog-generator"
export FPGA_AGENT_SKILLS_ROOT="/home/wjx/pythonproject/cktclaw/deps/FPGA-Agent-skills"

# ABC 可执行文件（优先使用 oss-cad-suite 附带的 yosys-abc）
export ABC_PATH="/home/wjx/.cktclaw-tools/oss-cad-suite/bin/yosys-abc"

# AIG->BENCH 输出模式（gate/lut/auto）
# 默认 gate：避免部分 yosys-abc 输出 LUT BENCH 导致下游 Graph 转换丢失结构
export CKTCLAW_BENCH_FORMAT="gate"

# AI4EDA 默认 Liberty 库（ASAP7）
export AI4EDA_DEFAULT_LIB="/home/wjx/pythonproject/cktclaw/deps/AI4EDA-OpenABC-Data-Toolkit/libs/asap7.lib"

# LogicRT 根目录（用于导入 scripts/inference_single_modal.py）
export CKTCLAW_LOGICRT_ROOT="/home/wjx/pythonproject/0reverse/GenEDA-main/reverse_engineering"

# DeepSeek API（请替换为你的 key）
